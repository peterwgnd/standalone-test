rules_version = '2';
service firebase.storage {
  
  match /b/{bucket}/o {
    match /reports/{surveySlug}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }

    // 3. Uploads Rule (For testing or data ingestion)
    match /uploads/{surveySlug}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
