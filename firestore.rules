rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Is the user an admin?
    function isAdmin() {
      return request.auth != null && (request.auth.token.admin == true || request.auth.token.admin == 'true');
    }

    // Helper: Check if a survey is open
    function isSurveyOpen(slug) {
      return get(/databases/$(database)/documents/surveys/$(slug)).data.status == 'open';
    }

    // Helper: Check if token is valid (or if token validation is not required)
    function isValidToken(slug, tokenId) {
      let reqToken = get(/databases/$(database)/documents/surveys/$(slug)).data.requireValidToken;
      return reqToken == false || reqToken == null || exists(/databases/$(database)/documents/surveys/$(slug)/respondents/$(tokenId));
    }

    // Helper: Validate answer string lengths (prevent DoW via large string payloads)
    function isValidAnswerLength(data) {
      return !('answers' in data) || (
        (!('0' in data.answers) || !('answer' in data.answers['0']) || (data.answers['0'].answer is string && data.answers['0'].answer.size() <= 2000)) &&
        (!('1' in data.answers) || !('answer' in data.answers['1']) || (data.answers['1'].answer is string && data.answers['1'].answer.size() <= 2000)) &&
        (!('2' in data.answers) || !('answer' in data.answers['2']) || (data.answers['2'].answer is string && data.answers['2'].answer.size() <= 2000)) &&
        (!('3' in data.answers) || !('answer' in data.answers['3']) || (data.answers['3'].answer is string && data.answers['3'].answer.size() <= 2000)) &&
        (!('4' in data.answers) || !('answer' in data.answers['4']) || (data.answers['4'].answer is string && data.answers['4'].answer.size() <= 2000)) &&
        (!('5' in data.answers) || !('answer' in data.answers['5']) || (data.answers['5'].answer is string && data.answers['5'].answer.size() <= 2000)) &&
        (!('6' in data.answers) || !('answer' in data.answers['6']) || (data.answers['6'].answer is string && data.answers['6'].answer.size() <= 2000)) &&
        (!('7' in data.answers) || !('answer' in data.answers['7']) || (data.answers['7'].answer is string && data.answers['7'].answer.size() <= 2000)) &&
        (!('8' in data.answers) || !('answer' in data.answers['8']) || (data.answers['8'].answer is string && data.answers['8'].answer.size() <= 2000)) &&
        (!('9' in data.answers) || !('answer' in data.answers['9']) || (data.answers['9'].answer is string && data.answers['9'].answer.size() <= 2000))
      );
    }

    // Helper: Prevent client-side spoofing or modifying AI state (followUpQuestion, error)
    function isAIStateUnchangedForQuestion(newAnswers, oldAnswers, key) {
      return !(key in newAnswers) || (
        (!('followUpQuestion' in newAnswers[key]) || (oldAnswers != null && key in oldAnswers && 'followUpQuestion' in oldAnswers[key] && newAnswers[key].followUpQuestion == oldAnswers[key].followUpQuestion)) &&
        (!('error' in newAnswers[key]) || (oldAnswers != null && key in oldAnswers && 'error' in oldAnswers[key] && newAnswers[key].error == oldAnswers[key].error))
      );
    }

    function isNotSpoofingAI(newData, oldData) {
      let newAnswers = 'answers' in newData ? newData.answers : {};
      let oldAnswers = oldData != null && 'answers' in oldData ? oldData.answers : {};
      return isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '0') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '1') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '2') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '3') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '4') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '5') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '6') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '7') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '8') &&
             isAIStateUnchangedForQuestion(newAnswers, oldAnswers, '9');
    }

    // Rules for the Admin Users collection
    match /admin_users/{uid} {
      allow read, write: if isAdmin();
    }

    // Rules for the Surveys collection
    match /surveys/{surveySlug} {
      
      // 1. Survey Configuration
      // Public can read integrated surveys (needed to load questions for respondents); uploaded surveys are admin-only
      allow read: if resource.data.type == 'integrated' || isAdmin();
      // Only admins can create/edit survey configurations
      allow write: if isAdmin();

      // 2. Responses Subcollection
      match /responses/{responseId} {
        // Public can submit or update responses if survey is open and token is valid (or admin),
        // response is not already completed, AI state is not spoofed,
        // and restrict map sizes and string lengths to prevent Denial of Wallet bloating
        allow create, update: if (isSurveyOpen(surveySlug)
                              && isValidToken(surveySlug, responseId)
                              && (resource == null || resource.data.status != 'completed')
                              && isNotSpoofingAI(request.resource.data, resource == null ? null : resource.data)
                              && request.resource.data.size() < 20
                              && (!('answers' in request.resource.data) || request.resource.data.answers.size() < 100)
                              && isValidAnswerLength(request.resource.data))
                              || isAdmin();
        
        // Allow a user to read a specific document if they know the exact random ID
        allow get: if true;
        
        // ONLY Admins can query the whole collection to see everyone's data or delete responses
        allow list, delete: if isAdmin();
      }

      // 3. Admin Metadata Subcollection
      match /admin/{adminDocId} {
        allow read, write: if isAdmin();
      }

      // 4. Respondents Subcollection (Tokens)
      match /respondents/{tokenId} {
        // Anyone can check if a specific token exists (needed for the invite link)
        allow get: if true;
        
        // Only admins can list all tokens or create/delete them
        allow list, write: if isAdmin();
      }
    }
    
    // Explicitly deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
